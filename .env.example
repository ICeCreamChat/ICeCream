# ICeCream 环境变量配置

# ================================
# 服务端口配置
# ================================
PORT=3000
MANIM_SERVICE_PORT=8001
MANIM_SERVICE_HOST=127.0.0.1
MANIM_SERVICE_URL=http://127.0.0.1:8001
MANIM_SERVICE_TOKEN=
MANIM_AUTO_FREE_PORT=false

# ================================
# Gateway 安全与限流配置
# ================================
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=20mb
FORM_BODY_LIMIT=20mb
API_RATE_LIMIT_PER_MINUTE=120
MANIM_RENDER_RATE_LIMIT_PER_MINUTE=6
OCR_RATE_LIMIT_PER_MINUTE=8

# ================================
# DeepSeek API (用于聊天和意图分类)
# ================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ================================
# SiliconFlow API (用于解题视觉服务)
# ================================
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# ================================
# 意图分类器配置
# ================================
INTENT_CONFIDENCE_THRESHOLD=0.75
INTENT_CLASSIFIER_ENABLED=true

# ================================
# MinerU 配置 (可选)
# ================================
MINERU_API_KEY=
MINERU_ENABLED=false

# ================================
# Timefold Solver (optional seating optimizer)
# ================================
TIMEFOLD_SOLVER_URL=
TIMEFOLD_SOLVER_TIMEOUT=8

# ================================
# Seating feedback email (optional)
# ================================
# If SMTP is configured, anonymized seating feedback is saved locally and sent here.
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=
FEEDBACK_LOG_DIR=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
