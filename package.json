{
    "name": "icecream",
    "version": "1.0.0",
    "description": "🍦 ICeCream - 统一智能平台，整合 AI 聊天、数学动画可视化与智能解题",
    "main": "gateway/server.js",
    "scripts": {
        "start": "node gateway/server.js",
        "dev": "node --watch gateway/server.js",
        "manim": "node scripts/run-manim.js",
        "dev:all": "concurrently \"npm start\" \"node scripts/run-manim.js\"",
        "solver:dev": "cd solver && .\\mvnw.cmd quarkus:dev",
        "solver:test": "cd solver && .\\mvnw.cmd test",
        "solver:build": "cd solver && .\\mvnw.cmd package -DskipTests",
        "build:studio": "esbuild src/manim-studio/main.jsx --bundle --format=iife --global-name=ManimStudioCanvas --outfile=public/js/studio/manim-studio-canvas.js --jsx=automatic --loader:.jsx=jsx",
        "build:timetable-v2": "esbuild public/js/tools/timetable-v2/entry.js --bundle --format=esm --outfile=public/js/tools/timetable-v2/dist/workbench.bundle.js --jsx=automatic --loader:.jsx=jsx",
        "test": "node --test test/*.js"
    },
    "keywords": [
        "ai",
        "chat",
        "manim",
        "math",
        "solver",
        "deepseek",
        "visualization"
    ],
    "author": "ICeCreamChat",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "adm-zip": "^0.5.16",
        "cors": "^2.8.5",
        "cropperjs": "^1.6.2",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "form-data": "^4.0.5",
        "https-proxy-agent": "^7.0.6",
        "konva": "^10.3.0",
        "lucide": "^0.563.0",
        "marked": "^17.0.1",
        "monaco-editor": "^0.45.0",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "^3.3.2",
        "nodemailer": "^8.0.7",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-konva": "^19.2.4",
        "sharp": "^0.33.2",
        "three": "^0.160.0",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^9.2.1",
        "esbuild": "^0.28.0",
        "vite": "^8.0.13"
    }
}
