{
    "name": "icecream",
    "version": "1.0.0",
    "description": "🍦 ICeCream - 统一智能平台，整合 AI 聊天、数学动画可视化与智能解题",
    "main": "gateway/server.js",
    "scripts": {
        "start": "node gateway/server.js",
        "dev": "node --watch gateway/server.js",
        "manim": "node scripts/run-manim.js",
        "dev:all": "concurrently \"npm start\" \"node scripts/run-manim.js\"",
        "solver:dev": "cd solver && .\\mvnw.cmd quarkus:dev",
        "solver:test": "cd solver && .\\mvnw.cmd test",
        "solver:build": "cd solver && .\\mvnw.cmd package -DskipTests",
        "cleanup:feedback": "node scripts/cleanup-feedback.js",
        "build:studio": "esbuild src/manim-studio/main.jsx --bundle --format=iife --global-name=ManimStudioCanvas --outfile=public/js/studio/manim-studio-canvas.js --jsx=automatic --loader:.jsx=jsx",
        "test:timetable:ui-smoke": "node test/timetable-ui-smoke.mjs",
        "test:timetable:workflow-smoke": "node test/timetable-ui-workflow-smoke.mjs",
        "test:timetable:rule-review-smoke": "node test/timetable-ui-rule-review-smoke.mjs",
        "test:timetable:roster-import-smoke": "node test/timetable-ui-roster-import-smoke.mjs",
        "test:seating:workflow-smoke": "node test/seating-ui-workflow-smoke.mjs",
        "test:timetable:ai-golden": "node scripts/run-timetable-ai-golden.js",
        "audit:timetable:market-language-local": "node scripts/run-timetable-market-language-corpus.js",
        "audit:timetable:natural-language-137": "node scripts/audit-timetable-natural-language-137.js",
        "test": "node --test --test-concurrency=1 test/*.js"
    },
    "keywords": [
        "ai",
        "chat",
        "manim",
        "math",
        "solver",
        "deepseek",
        "visualization"
    ],
    "author": "ICeCreamChat",
    "license": "MIT",
    "type": "module",
    "dependencies": {
        "@e965/xlsx": "0.20.3",
        "adm-zip": "^0.6.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "https-proxy-agent": "^7.0.6",
        "konva": "^10.3.0",
        "multer": "^1.4.5-lts.1",
        "node-fetch": "^3.3.2",
        "nodemailer": "^9.0.5",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-konva": "^19.2.4",
        "sharp": "^0.35.3",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "esbuild": "^0.28.0",
        "playwright": "^1.60.0"
    }
}
