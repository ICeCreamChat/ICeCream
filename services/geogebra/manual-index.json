[
  {
    "id": "command-circle",
    "type": "command",
    "title": "Circle",
    "keywords": ["circle", "radius", "center", "circumcircle", "圆", "圆心", "半径", "外接圆"],
    "summary": "Creates a circle from a center and radius, a center and point, or three points.",
    "syntax": ["Circle(<Point>, <Number>)", "Circle(<Point>, <Point>)", "Circle(<Point>, <Point>, <Point>)"],
    "examples": ["C = (0, 3)", "c = Circle(C, 3)", "circum = Circle(A, B, C)"],
    "source": "manual/en/commands/Circle"
  },
  {
    "id": "command-point",
    "type": "command",
    "title": "Point",
    "keywords": ["point", "object", "path", "free point", "点", "动点", "路径"],
    "summary": "Creates a point, including a movable point on a path such as a line, conic, segment, or circle.",
    "syntax": ["Point(<Object>)"],
    "examples": ["P = Point(c)", "A = (0, 0)"],
    "source": "manual/en/commands/Point"
  },
  {
    "id": "command-line",
    "type": "command",
    "title": "Line",
    "keywords": ["line", "through", "直线", "过两点"],
    "summary": "Creates a line, commonly through two points.",
    "syntax": ["Line(<Point>, <Point>)"],
    "examples": ["l = Line(A, B)"],
    "source": "manual/en/commands/Line"
  },
  {
    "id": "command-segment",
    "type": "command",
    "title": "Segment",
    "keywords": ["segment", "length", "弦", "线段", "边"],
    "summary": "Creates a segment between two points or from a point with a fixed length.",
    "syntax": ["Segment(<Point>, <Point>)", "Segment(<Point>, <Number>)"],
    "examples": ["s = Segment(O, P)"],
    "source": "manual/en/commands/Segment"
  },
  {
    "id": "command-midpoint",
    "type": "command",
    "title": "Midpoint",
    "keywords": ["midpoint", "center", "中点", "中心"],
    "summary": "Creates the midpoint of two points or the center of a conic.",
    "syntax": ["Midpoint(<Point>, <Point>)", "Midpoint(<Conic>)"],
    "examples": ["M = Midpoint(O, P)"],
    "source": "manual/en/commands/Midpoint"
  },
  {
    "id": "command-locus",
    "type": "command",
    "title": "Locus",
    "keywords": ["locus", "trace", "path", "轨迹", "动点", "几何轨迹"],
    "summary": "Returns the locus curve of a dependent point Q controlled by a point P on a path, or by a slider.",
    "syntax": ["Locus(<Point Creating Locus Line Q>, <Point P>)", "Locus(<Point Creating Locus Line Q>, <Slider t>)"],
    "examples": ["traceM = Locus(M, P)"],
    "source": "manual/en/commands/Locus"
  },
  {
    "id": "command-curve",
    "type": "command",
    "title": "Curve",
    "keywords": ["curve", "parametric", "参数曲线", "曲线"],
    "summary": "Creates a 2D or 3D parametric curve over a finite parameter interval.",
    "syntax": ["Curve(<Expression>, <Expression>, <Parameter Variable>, <Start Value>, <End Value>)"],
    "examples": ["Curve(2 cos(t), 2 sin(t), t, 0, 2 pi)"],
    "source": "manual/en/commands/Curve"
  },
  {
    "id": "command-polygon",
    "type": "command",
    "title": "Polygon",
    "keywords": ["polygon", "triangle", "quadrilateral", "三角形", "多边形", "四边形"],
    "summary": "Creates a polygon from a sequence of points.",
    "syntax": ["Polygon(<Point>, ..., <Point>)"],
    "examples": ["tri = Polygon(A, B, C)"],
    "source": "manual/en/commands/Polygon"
  },
  {
    "id": "command-intersect",
    "type": "command",
    "title": "Intersect",
    "keywords": ["intersect", "intersection", "交点", "相交"],
    "summary": "Creates intersection point(s) of two objects.",
    "syntax": ["Intersect(<Object>, <Object>)"],
    "examples": ["X = Intersect(c, l)"],
    "source": "manual/en/commands/Intersect"
  },
  {
    "id": "command-perpendicularline",
    "type": "command",
    "title": "PerpendicularLine",
    "keywords": ["perpendicular", "垂线", "垂直"],
    "summary": "Creates a line through a point perpendicular to a given line.",
    "syntax": ["PerpendicularLine(<Point>, <Line>)"],
    "examples": ["h = PerpendicularLine(A, l)"],
    "source": "manual/en/commands/PerpendicularLine"
  },
  {
    "id": "command-parallelline",
    "type": "command",
    "title": "ParallelLine",
    "keywords": ["parallel", "平行线", "平行"],
