    "syntax": ["boolean evalCommand(String cmdString)", "String evalCommandGetLabels(String cmdString)"],
    "examples": ["ggbApplet.evalCommand('A = (0, 0)')"],
    "source": "reference/en/GeoGebra_Apps_API"
  },
  {
    "id": "api-getbase64",
    "type": "api",
    "title": "getBase64",
    "keywords": ["api", "base64", "save", "ggb", "保存", "导出"],
