    "examples": ["t = Tangent(P, c)"],
    "source": "manual/en/commands/Tangent"
  },
  {
    "id": "command-ellipse",
    "type": "command",
    "title": "Ellipse",
    "keywords": ["ellipse", "conic", "椭圆", "焦点"],
