    "syntax": ["Ellipse(<Focus>, <Focus>, <Point>)", "Ellipse(<Focus>, <Focus>, <Number>)"],
    "examples": ["e = Ellipse(F1, F2, A)"],
    "source": "manual/en/commands/Ellipse"
  },
  {
    "id": "command-hyperbola",
    "type": "command",
    "title": "Hyperbola",
    "keywords": ["hyperbola", "conic", "双曲线", "焦点"],
    "summary": "Creates a hyperbola from foci and a point or distance.",
    "syntax": ["Hyperbola(<Focus>, <Focus>, <Point>)", "Hyperbola(<Focus>, <Focus>, <Number>)"],
    "examples": ["h = Hyperbola(F1, F2, A)"],
    "source": "manual/en/commands/Hyperbola"
  },
  {
    "id": "command-parabola",
    "type": "command",
    "title": "Parabola",
    "keywords": ["parabola", "conic", "抛物线", "焦点", "准线"],
    "summary": "Creates a parabola from a focus and directrix.",
    "syntax": ["Parabola(<Point>, <Line>)"],
    "examples": ["p = Parabola(F, d)"],
    "source": "manual/en/commands/Parabola"
  },
  {
    "id": "command-function",
    "type": "command",
    "title": "Function",
    "keywords": ["function", "graph", "函数", "图像"],
