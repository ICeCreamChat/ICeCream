    "summary": "Sets object color using RGB values.",
    "syntax": ["SetColor(<Object>, <Red>, <Green>, <Blue>)"],
    "examples": ["SetColor(M, 0.95, 0.35, 0.1)"],
    "source": "manual/en/commands/SetColor"
  },
  {
